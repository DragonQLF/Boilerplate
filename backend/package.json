{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express + TypeScript + Prisma + Better Auth backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
