NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@db:5432/mydb
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=change-this-secret-to-at-least-32-characters
BETTER_AUTH_SECRETS=
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info
# Dev: no password needed. Production: set REDIS_PASSWORD in your platform
# secrets and change REDIS_URL to redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://redis:6379
EMAIL_RATE_LIMIT_PER_HOUR=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
